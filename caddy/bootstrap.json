{
  "admin": {
    "listen": "unix//run/caddy/admin.sock|0660",
    "config": { "persist": false }
  },
  "apps": {
    "http": {
      "servers": {
        "cpm_default": {
          "listen": [":80"],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404,
                  "headers": { "Content-Type": ["text/plain; charset=utf-8"] },
                  "body": "No site is configured for this address.\n"
                }
              ]
            }
          ]
        }
      }
    }
  }
}
