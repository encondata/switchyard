# Copy to .env (never commit .env). Docker Compose reads it automatically.

# 32 random bytes, base64. Encrypts DNS provider tokens in CPM's database.
# Generate with: openssl rand -base64 32
# Keep a copy somewhere safe: without it, stored tokens can't be decrypted.
CPM_SECRET_KEY=

# Optional. Use Let's Encrypt staging while testing to avoid rate limits:
# CPM_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# CPM_ACME_EMAIL=ops@example.com

# Countries (country rules, dashboard) work out of the box: CPM downloads
# DB-IP's free IP-to-Country Lite database monthly (CC BY 4.0, db-ip.com).
# Optional: use MaxMind GeoLite2 instead. Free account at
# https://www.maxmind.com/en/geolite2/signup, then start with
# `docker compose --profile geoip up -d`. Set CPM_GEOIP_DOWNLOAD=off to stop the
# DB-IP download.
# CPM_GEOIP_DOWNLOAD=on
# GEOIPUPDATE_ACCOUNT_ID=
# GEOIPUPDATE_LICENSE_KEY=

# Optional: move the published ports (defaults 80, 443 and 8080), e.g. to
# test next to a proxy that already has 80 and 443.
# SWITCHYARD_HTTP_PORT=80
# SWITCHYARD_HTTPS_PORT=443
# SWITCHYARD_UI_PORT=8080

# Optional: Sign in with HackSpaceLabs (Keycloak). The HackSpaceLabs installer's
# deployment/scripts/app-env.mjs writes these for you. Needs CPM_SECRET_KEY, and
# CPM_PUBLIC_URL must be the address people use (it is registered in Keycloak).
# CPM_PUBLIC_URL=https://switchyard.example.com
# CPM_SECURE_COOKIES=true
# HSL_OIDC_ISSUER=https://auth.hackspacelabs.com/realms/hackspacelabs
# HSL_OIDC_CLIENT_ID=switchyard
# HSL_OIDC_CLIENT_SECRET=
# Only if CPM can't reach the issuer's public address: an origin to use for
# server-to-server calls instead, e.g. http://192.168.1.10:8089
# HSL_OIDC_INTERNAL_URL=
# Send signed-out visitors straight to HackSpaceLabs (the local sign-in form
# stays at /login?local=1 for when Keycloak is down).
# HSL_OIDC_AUTO_REDIRECT=false
# How often a session is rechecked with Keycloak, in seconds.
# HSL_OIDC_RECHECK_SECONDS=60
# The portal and the app switcher.
# HSL_PORTAL_URL=https://hackspacelabs.com
# HSL_SUITE_APPS=portal|HackSpaceLabs|https://hackspacelabs.com/apps,switchyard|Switchyard|https://switchyard.example.com
