# Copy to .env (never commit .env). Docker Compose reads it automatically.

# 32 random bytes, base64. Encrypts DNS provider tokens in CPM's database.
# Generate with: openssl rand -base64 32
# Keep a copy somewhere safe: without it, stored tokens can't be decrypted.
CPM_SECRET_KEY=

# Optional. Use Let's Encrypt staging while testing to avoid rate limits:
# CPM_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# CPM_ACME_EMAIL=ops@example.com

# Optional: GeoLite2 country database for country rules and the dashboard.
# Free account at https://www.maxmind.com/en/geolite2/signup, then start
# with `docker compose --profile geoip up -d`.
# GEOIPUPDATE_ACCOUNT_ID=
# GEOIPUPDATE_LICENSE_KEY=

# Optional: move the published ports (defaults 80, 443 and 8080), e.g. to
# test next to a proxy that already has 80 and 443.
# SWITCHYARD_HTTP_PORT=80
# SWITCHYARD_HTTPS_PORT=443
# SWITCHYARD_UI_PORT=8080
