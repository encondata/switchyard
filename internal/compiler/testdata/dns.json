{
  "admin": {
    "config": {
      "persist": false
    },
    "listen": "unix//run/caddy/admin.sock|0660"
  },
  "apps": {
    "http": {
      "servers": {
        "cpm_http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "@id": "cpm_banlist_http",
              "handle": [
                {
                  "early": true,
                  "handler": "log_append",
                  "key": "cpm_blocked",
                  "value": "banned"
                },
                {
                  "abort": true,
                  "handler": "static_response"
                }
              ],
              "match": [
                {
                  "client_ip": {
                    "ranges": [
                      "0.0.0.0/32"
                    ]
                  }
                }
              ],
              "terminal": true
            },
            {
              "@id": "cpm_host_1_redirect",
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": "308"
                }
              ],
              "match": [
                {
                  "host": [
                    "nas.lan.example.com",
                    "*.lan.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "@id": "cpm_host_2_redirect",
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": "308"
                }
              ],
              "match": [
                {
                  "host": [
                    "www.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "@id": "cpm_not_configured_http",
              "handle": [
                {
                  "body": "No site is configured for this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": "404"
                }
              ]
            }
          ]
        },
        "cpm_https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "@id": "cpm_banlist_https",
              "handle": [
                {
                  "early": true,
                  "handler": "log_append",
                  "key": "cpm_blocked",
                  "value": "banned"
                },
                {
                  "abort": true,
                  "handler": "static_response"
                }
              ],
              "match": [
                {
                  "client_ip": {
                    "ranges": [
                      "0.0.0.0/32"
                    ]
                  }
                }
              ],
              "terminal": true
            },
            {
              "@id": "cpm_host_1",
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "nas:5000"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "nas.lan.example.com",
                    "*.lan.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "@id": "cpm_host_2",
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "web:80"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "www.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "@id": "cpm_not_configured_https",
              "handle": [
                {
                  "body": "No site is configured for this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": "404"
                }
              ]
            }
          ]
        }
      }
    },
    "pki": {
      "certificate_authorities": {
        "local": {
          "install_trust": false
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "ca": "https://acme-staging-v02.api.letsencrypt.org/directory",
                "challenges": {
                  "dns": {
                    "provider": {
                      "api_token": "{file./run/cpm-secrets/dns-7.token}",
                      "name": "cloudflare"
                    },
                    "resolvers": [
                      "1.1.1.1",
                      "1.0.0.1"
                    ]
                  }
                },
                "email": "ops@example.com",
                "module": "acme"
              }
            ],
            "subjects": [
              "nas.lan.example.com",
              "*.lan.example.com"
            ]
          },
          {
            "issuers": [
              {
                "ca": "https://acme-staging-v02.api.letsencrypt.org/directory",
                "email": "ops@example.com",
                "module": "acme"
              }
            ]
          }
        ]
      }
    }
  }
}
