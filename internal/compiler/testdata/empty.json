{
  "admin": {
    "config": {
      "persist": false
    },
    "listen": "unix//run/caddy/admin.sock|0660"
  },
  "apps": {
    "http": {
      "servers": {
        "cpm_http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "@id": "cpm_banlist_http",
              "handle": [
                {
                  "early": true,
                  "handler": "log_append",
                  "key": "cpm_blocked",
                  "value": "banned"
                },
                {
                  "abort": true,
                  "handler": "static_response"
                }
              ],
              "match": [
                {
                  "client_ip": {
                    "ranges": [
                      "0.0.0.0/32"
                    ]
                  }
                }
              ],
              "terminal": true
            },
            {
              "@id": "cpm_not_configured_http",
              "handle": [
                {
                  "body": "No site is configured for this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": "404"
                }
              ]
            }
          ]
        },
        "cpm_https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "@id": "cpm_banlist_https",
              "handle": [
                {
                  "early": true,
                  "handler": "log_append",
                  "key": "cpm_blocked",
                  "value": "banned"
                },
                {
                  "abort": true,
                  "handler": "static_response"
                }
              ],
              "match": [
                {
                  "client_ip": {
                    "ranges": [
                      "0.0.0.0/32"
                    ]
                  }
                }
              ],
              "terminal": true
            },
            {
              "@id": "cpm_not_configured_https",
              "handle": [
                {
                  "body": "No site is configured for this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": "404"
                }
              ]
            }
          ]
        }
      }
    },
    "pki": {
      "certificate_authorities": {
        "local": {
          "install_trust": false
        }
      }
    }
  }
}
