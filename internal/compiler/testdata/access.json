{
  "admin": {
    "config": {
      "persist": false
    },
    "listen": "unix//run/caddy/admin.sock|0660"
  },
  "apps": {
    "http": {
      "servers": {
        "cpm_http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "@id": "cpm_host_1",
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "abort": true,
                          "handler": "static_response"
                        }
                      ],
                      "match": [
                        {
                          "client_ip": {
                            "ranges": [
                              "10.66.0.0/16"
                            ]
                          },
                          "not": [
                            {
                              "client_ip": {
                                "ranges": [
                                  "203.0.113.7"
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "abort": true,
                          "handler": "static_response"
                        }
                      ],
                      "match": [
                        {
                          "not": [
                            {
                              "client_ip": {
                                "ranges": [
                                  "100.64.0.0/10",
                                  "10.0.0.0/8",
                                  "192.168.0.0/16"
                                ]
                              }
                            },
                            {
                              "client_ip": {
                                "ranges": [
                                  "203.0.113.7"
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "whoami:80"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "tools.localhost"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "@id": "cpm_host_2",
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "whoami:80"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "open.localhost"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "@id": "cpm_not_configured_http",
              "handle": [
                {
                  "body": "No site is configured for this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": "404"
                }
              ]
            }
          ]
        },
        "cpm_https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "@id": "cpm_not_configured_https",
              "handle": [
                {
                  "body": "No site is configured for this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": "404"
                }
              ]
            }
          ]
        }
      }
    },
    "pki": {
      "certificate_authorities": {
        "local": {
          "install_trust": false
        }
      }
    }
  }
}
