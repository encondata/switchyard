{
  "admin": {
    "config": {
      "persist": false
    },
    "listen": "unix//run/caddy/admin.sock|0660"
  },
  "apps": {
    "http": {
      "servers": {
        "cpm_http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "@id": "cpm_host_1",
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "early": true,
                          "handler": "log_append",
                          "key": "cpm_blocked",
                          "value": "deny:policy:2"
                        },
                        {
                          "abort": true,
                          "handler": "static_response"
                        }
                      ],
                      "match": [
                        {
                          "maxmind_geolocation": {
                            "allow_countries": [
                              "RU"
                            ],
                            "db_path": "/usr/share/GeoIP/GeoLite2-Country.mmdb"
                          }
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "early": true,
                          "handler": "log_append",
                          "key": "cpm_blocked",
                          "value": "not_allowed"
                        },
                        {
                          "body": "Access denied.\n",
                          "handler": "static_response",
                          "headers": {
                            "Content-Type": [
                              "text/plain; charset=utf-8"
                            ]
                          },
                          "status_code": "403"
                        }
                      ],
                      "match": [
                        {
                          "not": [
                            {
                              "client_ip": {
                                "ranges": [
                                  "10.0.0.0/8"
                                ]
                              }
                            },
                            {
                              "maxmind_geolocation": {
                                "allow_countries": [
                                  "US",
                                  "CA"
                                ],
                                "db_path": "/usr/share/GeoIP/GeoLite2-Country.mmdb"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "body": "Not found.\n",
                          "handler": "static_response",
                          "headers": {
                            "Content-Type": [
                              "text/plain; charset=utf-8"
                            ]
                          },
                          "status_code": "404"
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "geo.localhost"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "@id": "cpm_not_configured_http",
              "handle": [
                {
                  "body": "No site is configured for this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": "404"
                }
              ]
            }
          ]
        },
        "cpm_https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "@id": "cpm_not_configured_https",
              "handle": [
                {
                  "body": "No site is configured for this address.\n",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/plain; charset=utf-8"
                    ]
                  },
                  "status_code": "404"
                }
              ]
            }
          ]
        }
      }
    },
    "pki": {
      "certificate_authorities": {
        "local": {
          "install_trust": false
        }
      }
    }
  }
}
